import os

# Assume this matches the UUID of your storage/reserved space partition
DATA_PARTITION_UUID = "1234-ABCD-EFGH" 

GRUB_TEMPLATE = """# Dynamically generated by Yumi.py
menuentry "Immux Dynamic Launch: {title}" --id="dynamic_target" {{
    search --no-floppy --fs-uuid --set=iso_dev {partition_uuid}
    set isofile="{iso_path}"
    echo "Mounting: $isofile"
    loopback loop ($iso_dev)$isofile
    set root=(loop)
    echo "Loading kernel and staging ramdisk..."
    linux {kernel_bin} {boot_params} img_dev=/dev/disk/by-uuid/{partition_uuid} img_loop=$isofile
    initrd {initrd_bin}
}}
"""

def set_next_boot_target(iso_id):
    iso_data = ISO_POOL[iso_id]
    
    # Double-check local presence before altering the boot track
    if not os.path.exists(iso_data["local_path"]):
        print(f"❌ Aborting. {iso_data['title']} is missing from local cache.")
        return False

    # Standardize paths relative to the partition mount root for GRUB
    # e.g., converts /mnt/reserved_space/iso/4m.iso -> /iso/4m.iso
    relative_iso_path = iso_data["local_path"].replace("/mnt/reserved_space", "")

    # Inject the payload details into our strict GRUB loopback configuration
    payload = GRUB_TEMPLATE.format(
        title=iso_data["title"],
        partition_uuid=DATA_PARTITION_UUID,
        iso_path=relative_iso_path,
        kernel_bin=iso_data.get("kernel_bin", "/boot/vmlinuz"),       # Fallback defaults
        initrd_bin=iso_data.get("initrd_bin", "/boot/initrd.img"),
        boot_params=iso_data.get("boot_params", "boot=live quiet splash")
    )
    
    try:
        # Write out the dynamic configuration
        with open("/boot/next_boot.cfg", "w") as cfg:
            cfg.write(payload)
            
        # Optional: Force reset the GRUB failure counter since we know we have a valid ISO local
        os.system("grub-editenv /boot/grub/grubenv set boot_tracking=cleared")
        
        print(f"🚀 [Staged] {iso_data['title']} ready. Reboot to initialize.")
        return True
    except IOError as e:
        print(f"❌ Failed to write boot target configuration: {e}")
        return False
